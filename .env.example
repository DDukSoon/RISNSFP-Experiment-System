# ─────────────────────────────────────────────────────────────────
#  HCI-experiment environment variable template
#
#  Usage:
#    1) Copy this file to ".env" in the same folder
#    2) Fill in the <YOUR_*_HERE> parts with the actual key values
#    3) Loaded automatically on server start (app/config.py::load_dotenv)
#
#  NOTE: the .env file is git-ignored via .gitignore. Never commit it.
# ─────────────────────────────────────────────────────────────────

# ── Required keys ────────────────────────────────────────────────

# ElevenLabs STT (Scribe) + TTS (multilingual). The server exits with code 2 if this key is missing.
ELEVENLABS_API_KEY=<YOUR_ELEVENLABS_KEY_HERE>

# Gemini API. Needed for Phase 2 scenario generation (scenario_generator.py).
GEMINI_API_KEY=<YOUR_GEMINI_KEY_HERE>


# ── Optional (default.yaml + code defaults are sufficient; set only to override) ──

# ElevenLabs voice/model — changing it automatically splits voice_cache into a new voice_id folder.
#ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
#ELEVENLABS_MODEL=eleven_multilingual_v2
#ELEVENLABS_STT_MODEL=scribe_v1

# Phase 1 behavior tuning
#PHASE1_SHUTDOWN_DELAY_SEC=8

# Server binding (if Unity is on the same PC, leave it as 0.0.0.0:8000)
#HCI_HOST=0.0.0.0
#HCI_PORT=8000
